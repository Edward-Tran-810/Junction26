{"id": "r09_43", "text": "Put the red objects in the left bin and the blue objects in the right bin. Leave the yellow objects where they are.", "gt": {"red/cube": "left", "red/cylinder": "left", "red/triangle": "left", "yellow/cube": null, "yellow/cylinder": null, "yellow/triangle": null, "blue/cube": "right", "blue/cylinder": "right", "blue/triangle": "right"}, "category": "counter", "adversarial": false}
{"id": "r09_44", "text": "Only sort the yellow and blue objects: yellow to the middle bin, blue to the left bin.", "gt": {"red/cube": null, "red/cylinder": null, "red/triangle": null, "yellow/cube": "center", "yellow/cylinder": "center", "yellow/triangle": "center", "blue/cube": "left", "blue/cylinder": "left", "blue/triangle": "left"}, "category": "counter", "adversarial": false}
