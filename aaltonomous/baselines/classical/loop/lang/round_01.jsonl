{"id": "r01_01", "text": "Drop every yellow item into the right bin, blue items into the left bin, and red items into the center bin.", "gt": {"red/cube": "center", "red/cylinder": "center", "red/triangle": "center", "yellow/cube": "right", "yellow/cylinder": "right", "yellow/triangle": "right", "blue/cube": "left", "blue/cylinder": "left", "blue/triangle": "left"}, "category": "paraphrase", "adversarial": false}
