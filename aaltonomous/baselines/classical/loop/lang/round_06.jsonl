{"id": "r06_27", "text": "Every yellow object should end up in the middle bin, every red object in the left bin, and every blue object in the right bin.", "gt": {"red/cube": "left", "red/cylinder": "left", "red/triangle": "left", "yellow/cube": "center", "yellow/cylinder": "center", "yellow/triangle": "center", "blue/cube": "right", "blue/cylinder": "right", "blue/triangle": "right"}, "category": "colour", "adversarial": false}
