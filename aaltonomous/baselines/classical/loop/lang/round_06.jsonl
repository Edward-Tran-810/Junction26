{"id": "r06_29", "text": "Put red on the left. Put blue on the left. Put yellow in the center.", "gt": {"red/cube": "left", "red/cylinder": "left", "red/triangle": "left", "yellow/cube": "center", "yellow/cylinder": "center", "yellow/triangle": "center", "blue/cube": "left", "blue/cylinder": "left", "blue/triangle": "left"}, "category": "colour", "adversarial": false}
