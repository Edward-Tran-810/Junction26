{"id": "r06_60", "text": "Blue's going in the middle. Red, on the right. Yellow, then, on the left.", "gt": {"red/cube": "right", "red/cylinder": "right", "red/triangle": "right", "yellow/cube": "left", "yellow/cylinder": "left", "yellow/triangle": "left", "blue/cube": "center", "blue/cylinder": "center", "blue/triangle": "center"}, "category": "adv_gapping", "adversarial": true}
