{"id": "r06_45", "text": "Yellow goes in the right bin and red goes in the left bin; leave the blue pieces on the counter.", "gt": {"red/cube": "left", "red/cylinder": "left", "red/triangle": "left", "yellow/cube": "right", "yellow/cylinder": "right", "yellow/triangle": "right", "blue/cube": null, "blue/cylinder": null, "blue/triangle": null}, "category": "counter", "adversarial": false}
