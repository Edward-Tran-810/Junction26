{"id": "r06_58", "text": "The yellow one shaped like a soda can goes in the left bin; every other yellow piece goes in the right bin. Reds and blues both go in the middle.", "gt": {"red/cube": "center", "red/cylinder": "center", "red/triangle": "center", "yellow/cube": "right", "yellow/cylinder": "left", "yellow/triangle": "right", "blue/cube": "center", "blue/cylinder": "center", "blue/triangle": "center"}, "category": "adv_shape_synonym", "adversarial": true}
