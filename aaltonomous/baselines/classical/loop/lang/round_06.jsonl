{"id": "r06_33", "text": "Red objects go left, yellow objects go right and blue objects go in the middle, but any cylinder, whatever its colour, goes in the right bin.", "gt": {"red/cube": "left", "red/cylinder": "right", "red/triangle": "left", "yellow/cube": "right", "yellow/cylinder": "right", "yellow/triangle": "right", "blue/cube": "center", "blue/cylinder": "right", "blue/triangle": "center"}, "category": "shape", "adversarial": false}
