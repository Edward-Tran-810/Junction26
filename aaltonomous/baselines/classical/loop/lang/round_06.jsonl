{"id": "r06_55", "text": "quick one no time for punctuation red on the right not the middle yellow in the middle not the left blue on the left", "gt": {"red/cube": "right", "red/cylinder": "right", "red/triangle": "right", "yellow/cube": "center", "yellow/cylinder": "center", "yellow/triangle": "center", "blue/cube": "left", "blue/cylinder": "left", "blue/triangle": "left"}, "category": "adv_runon_negbin", "adversarial": true}
{"id": "r06_56", "text": "The left bin might look like the obvious spot for the blue ones, but they must go in the right bin. Reds go in the left bin and yellows in the middle.", "gt": {"red/cube": "left", "red/cylinder": "left", "red/triangle": "left", "yellow/cube": "center", "yellow/cylinder": "center", "yellow/triangle": "center", "blue/cube": "right", "blue/cylinder": "right", "blue/triangle": "right"}, "category": "adv_hedge_contrast", "adversarial": true}
