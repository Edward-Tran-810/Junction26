{"id": "r06_01", "text": "Put the reds on the right, the yellows in the middle and the blues on the left.", "gt": {"red/cube": "right", "red/cylinder": "right", "red/triangle": "right", "yellow/cube": "center", "yellow/cylinder": "center", "yellow/triangle": "center", "blue/cube": "left", "blue/cylinder": "left", "blue/triangle": "left"}, "category": "colour", "adversarial": false}
