{"id": "r10_37", "text": "Each blue object goes to the left bin and each red object goes to the right bin. Yellow cubes go to the center bin, and the other yellow objects go to the left bin with the blues.", "gt": {"red/cube": "right", "red/cylinder": "right", "red/triangle": "right", "yellow/cube": "center", "yellow/cylinder": "left", "yellow/triangle": "left", "blue/cube": "left", "blue/cylinder": "left", "blue/triangle": "left"}, "category": "shape_colour_split", "adversarial": false}
