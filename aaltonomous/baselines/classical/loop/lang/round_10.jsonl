{"id": "r10_29", "text": "Separate the colours: red objects to the left bin, yellow objects to the right bin, blue objects to the centre bin.", "gt": {"red/cube": "left", "red/cylinder": "left", "red/triangle": "left", "yellow/cube": "right", "yellow/cylinder": "right", "yellow/triangle": "right", "blue/cube": "center", "blue/cylinder": "center", "blue/triangle": "center"}, "category": "colour_perm", "adversarial": false}
