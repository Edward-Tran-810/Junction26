{"id": "r10_01", "text": "Please sort the items by colour: reds to the right-hand bin, yellows to the left-hand bin, and blues into the middle one.", "gt": {"red/cube": "right", "red/cylinder": "right", "red/triangle": "right", "yellow/cube": "left", "yellow/cylinder": "left", "yellow/triangle": "left", "blue/cube": "center", "blue/cylinder": "center", "blue/triangle": "center"}, "category": "colour_perm", "adversarial": false}
