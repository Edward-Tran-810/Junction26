{"id": "r10_13", "text": "Sort the objects so that each colour ends up in its own bin: red on the left, blue in the middle, yellow on the right.", "gt": {"red/cube": "left", "red/cylinder": "left", "red/triangle": "left", "yellow/cube": "right", "yellow/cylinder": "right", "yellow/triangle": "right", "blue/cube": "center", "blue/cylinder": "center", "blue/triangle": "center"}, "category": "colour_perm", "adversarial": false}
{"id": "r10_14", "text": "Place crimson items in the right container, golden-yellow items in the left container and navy items in the central container.", "gt": {"red/cube": "right", "red/cylinder": "right", "red/triangle": "right", "yellow/cube": "left", "yellow/cylinder": "left", "yellow/triangle": "left", "blue/cube": "center", "blue/cylinder": "center", "blue/triangle": "center"}, "category": "colour_synonym", "adversarial": false}
