{"id": "r10_09", "text": "Every red thing belongs in the centre bin. The yellow things and the blue things share the bin on the left.", "gt": {"red/cube": "center", "red/cylinder": "center", "red/triangle": "center", "yellow/cube": "left", "yellow/cylinder": "left", "yellow/triangle": "left", "blue/cube": "left", "blue/cylinder": "left", "blue/triangle": "left"}, "category": "colour_shared", "adversarial": false}
{"id": "r10_10", "text": "I'd like the bin on the far right to collect anything blue, the bin on the far left anything red, and the middle bin anything yellow.", "gt": {"red/cube": "left", "red/cylinder": "left", "red/triangle": "left", "yellow/cube": "center", "yellow/cylinder": "center", "yellow/triangle": "center", "blue/cube": "right", "blue/cylinder": "right", "blue/triangle": "right"}, "category": "colour_perm", "adversarial": false}
{"id": "r10_11", "text": "Yellow into the middle, blue into the left, red into the right.", "gt": {"red/cube": "right", "red/cylinder": "right", "red/triangle": "right", "yellow/cube": "center", "yellow/cylinder": "center", "yellow/triangle": "center", "blue/cube": "left", "blue/cylinder": "left", "blue/triangle": "left"}, "category": "colour_perm", "adversarial": false}
