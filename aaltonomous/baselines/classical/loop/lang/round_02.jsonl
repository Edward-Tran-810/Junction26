{"id": "r02_53", "text": "First, blue cylinders to the center bin. Second, red cylinders to the center bin as well. Whatever remains goes in the left bin.", "gt": {"red/cube": "left", "red/cylinder": "center", "red/triangle": "left", "yellow/cube": "left", "yellow/cylinder": "left", "yellow/triangle": "left", "blue/cube": "left", "blue/cylinder": "center", "blue/triangle": "left"}, "category": "the_rest", "adversarial": false}
